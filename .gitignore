# Dependencies
node_modules/
package-lock.json.bak

# Build / Output videos
out/
dist/

# Ignore media generated in root, but KEEP everything inside public/
*.mp4
*.webm
*.png
*.jpg
*.wav

# Explicitly UNIGNORE all assets inside public/
!public/
!public/**

# Remotion cache & temporary files
.remotion/
chrome-headless-shell/

# Environment and sensitive keys
.env
.env.local
*.log
npm-debug.log*

# OS metadata
.DS_Store
Thumbs.db
